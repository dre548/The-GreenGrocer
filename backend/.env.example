# Copy this file to .env and fill in real values.
# .env is already gitignored — never commit real secrets.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/greengrocer"

# --- Redis (cache-manager) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate a strong random string, e.g.: openssl rand -base64 48
JWT_SECRET=""

# --- M-Pesa Daraja (sandbox credentials from developer.safaricom.co.ke) ---
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
CALLBACK_URL="https://your-ngrok-or-prod-domain/payments/callback"

# --- M-Pesa B2C payouts (only needed once vendor/rider payouts go live) ---
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""

# --- Africa's Talking (OTP SMS) ---
# Get these from africastalking.com — use username "sandbox" and your
# sandbox API key while testing; switch to your live app's username/key
# once you're sending real SMS.
AT_USERNAME=""
AT_API_KEY=""

# --- Google Distance Matrix (delivery fee calculation at checkout) ---
# Same Google Cloud project as your Maps/Places/Geocoding keys — just
# enable "Distance Matrix API" for it in the Cloud Console.
DISTANCE_MATRIX_API_KEY=""

# --- Email OTP fallback (nodemailer via SMTP) ---
# Works with Gmail (use an App Password, not your real password — see
# https://myaccount.google.com/apppasswords) or any SMTP provider.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="The Greengrocer <no-reply@greengrocer.app>"
