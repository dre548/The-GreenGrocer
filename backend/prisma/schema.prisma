generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum OrderStatus {
  PLACED
  ACCEPTED_BY_VENDOR
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum TransactionType {
  CHARGE
  PAYOUT
  REFUND
  CREDIT
}

enum TransactionParty {
  VENDOR
  RIDER
  PLATFORM
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RatingTarget {
  VENDOR
  RIDER
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  REJECTED
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentMethodType {
  SEND_MONEY
  PAYBILL
  BUY_GOODS
}

// Singleton-style config (always just one row) powering the admin-toggleable
// "can't see the M-Pesa prompt?" fallback note shown at checkout, with
// manual payment instructions for whichever method the admin has active.
model PaymentSettings {
  id                String            @id @default(uuid())
  active_method     PaymentMethodType @default(SEND_MONEY)
  send_money_number String?
  paybill_number    String?
  paybill_account   String?
  buy_goods_till    String?
  note_enabled      Boolean           @default(false)
  note_text         String?
  updated_at        DateTime          @updatedAt
}

model User {
  id                  String   @id @default(uuid())
  phone               String   @unique
  email               String?  @unique
  name                String
  role                UserRole @default(CUSTOMER)
  cash_wallet_balance Float    @default(0)
  created_at          DateTime @default(now())

  vendorProfile   Vendor?
  riderProfile    Rider?
  orders          Order[]
  disputesRaised  Dispute[]
  supportTickets  SupportTicket[]
  favorites       FavoriteVendor[]
  chatMessages    ChatMessage[]
  familyAsOwner   FamilyMember[] @relation("FamilyOwner")
  familyAsMember  FamilyMember[] @relation("FamilyMember")
}

model Vendor {
  id              String         @id @default(uuid())
  user_id         String         @unique
  business_name   String
  location        String?
  opening_hours   String?
  commission_rate Float?
  status          ApprovalStatus @default(PENDING)
  wallet_balance  Float          @default(0)
  is_open         Boolean        @default(true)

  user            User           @relation(fields: [user_id], references: [id])
  orders          Order[]
  products        Product[]
}

model Rider {
  id             String         @id @default(uuid())
  user_id        String         @unique
  vehicle_type   String
  plate_number   String
  id_front_url   String
  id_back_url    String
  status         ApprovalStatus @default(PENDING)
  wallet_balance Float          @default(0)

  user           User           @relation(fields: [user_id], references: [id])
  deliveries     Order[]
}

model Product {
  id         String   @id @default(uuid())
  vendor_id  String?
  name       String
  price      Int
  emoji      String?
  unit       String
  image_url  String?
  in_stock   Boolean  @default(true)
  created_at DateTime @default(now())

  vendor     Vendor?  @relation(fields: [vendor_id], references: [id])
}

model Order {
  id             String      @id @default(uuid())
  customer_id    String
  vendor_id      String
  rider_id       String?
  items          Json
  subtotal       Int
  delivery_fee   Int
  total          Int
  payment_method String
  status         OrderStatus @default(PLACED)
  created_at     DateTime    @default(now())

  customer       User          @relation(fields: [customer_id], references: [id])
  vendor         Vendor        @relation(fields: [vendor_id], references: [id])
  rider          Rider?        @relation(fields: [rider_id], references: [id])
  transactions   Transaction[]
  ratings        Rating[]
  disputes       Dispute[]
  chatMessages   ChatMessage[]
}

// Ledger of money movement: order charges, vendor/rider payouts, refunds,
// and wallet credits. This is what the Admin payout dashboard reads from.
model Transaction {
  id         String            @id @default(uuid())
  order_id   String?
  type       TransactionType
  party      TransactionParty
  party_id   String            // vendor.id or rider.id (matches `party`), or "PLATFORM"
  amount     Float
  method     String?           // e.g. "M-PESA", "Bank Transfer"
  status     TransactionStatus @default(PENDING)
  created_at DateTime          @default(now())

  order      Order?            @relation(fields: [order_id], references: [id])
}

// Customer ratings for a vendor or rider after a delivered order.
model Rating {
  id         String       @id @default(uuid())
  order_id   String
  target     RatingTarget
  target_id  String       // vendor.id or rider.id
  score      Int
  comment    String?
  created_at DateTime     @default(now())

  order      Order        @relation(fields: [order_id], references: [id])
}

// --- Admin: Disputes/Refunds tab ---
model Dispute {
  id         String        @id @default(uuid())
  order_id   String
  raised_by  String        // user.id of whoever filed it
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  created_at DateTime      @default(now())

  order      Order         @relation(fields: [order_id], references: [id])
  raiser     User          @relation(fields: [raised_by], references: [id])
}

// --- Admin: Fraud Flags tab ---
model FraudFlag {
  id         String        @id @default(uuid())
  order_id   String?
  user_id    String?
  reason     String
  severity   FraudSeverity @default(LOW)
  resolved   Boolean       @default(false)
  created_at DateTime      @default(now())
}

// --- Admin: City/Zone Config tab ---
model ZoneConfig {
  id                 String   @id @default(uuid())
  city               String
  zone_name          String
  surge_multiplier   Float    @default(1.0)
  delivery_radius_km Float    @default(5.0)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
}

// --- Admin: Support Queue tab ---
model SupportTicket {
  id         String              @id @default(uuid())
  user_id    String
  subject    String
  message    String
  status     SupportTicketStatus @default(OPEN)
  created_at DateTime            @default(now())

  user       User                @relation(fields: [user_id], references: [id])
}

// --- Customer: Favourites ---
model FavoriteVendor {
  id         String   @id @default(uuid())
  user_id    String
  vendor_id  String
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, vendor_id])
}

// --- Customer: Promotions/vouchers ---
model Promotion {
  id           String    @id @default(uuid())
  code         String    @unique
  description  String
  discount_pct Float?
  flat_amount  Float?
  active       Boolean   @default(true)
  expires_at   DateTime?
  created_at   DateTime  @default(now())
}

// --- Customer: Family sharing ---
model FamilyMember {
  id             String   @id @default(uuid())
  owner_id       String   // the paying/primary account
  member_id      String   // the invited user
  spending_limit Float?
  created_at     DateTime @default(now())

  owner          User     @relation("FamilyOwner", fields: [owner_id], references: [id])
  member         User     @relation("FamilyMember", fields: [member_id], references: [id])

  @@unique([owner_id, member_id])
}

// --- Message Center: order-scoped chat between customer/vendor/rider ---
model ChatMessage {
  id          String   @id @default(uuid())
  order_id    String
  sender_id   String
  sender_role String   // "CUSTOMER" | "VENDOR" | "RIDER"
  message     String
  created_at  DateTime @default(now())

  order       Order    @relation(fields: [order_id], references: [id])
  sender      User     @relation(fields: [sender_id], references: [id])
}