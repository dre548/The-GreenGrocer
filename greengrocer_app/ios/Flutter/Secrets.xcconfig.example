// Copy this file to Secrets.xcconfig (same folder) and fill in your real
// key. Secrets.xcconfig is gitignored — never commit real keys.
//
// This is the SAME key as MAPS_SDK_KEY in your app-level .env — iOS reads
// it through this xcconfig -> Info.plist -> AppDelegate.swift chain,
// not from Dart/.env, since Dart code can't reach native config at build time.

GOOGLE_MAPS_API_KEY = AIzaSy_your_real_maps_sdk_key_here
