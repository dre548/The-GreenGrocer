# Copy this file to .env in this same folder (greengrocer_app/) and fill in
# real values. .env is already gitignored — never commit real keys.

# Your backend's public URL (ngrok tunnel while developing, real domain in prod)
API_BASE_URL="https://your-ngrok-or-prod-domain"

# --- Google Maps (all from the same Cloud Console project) ---
MAPS_SDK_KEY=""
GEOCODING_API_KEY=""
PLACES_API_KEY=""
# Powers the route polyline drawn on the map (Directions API) — enable
# "Directions API" for this key in Google Cloud Console.
DIRECTIONS_API_KEY=""
