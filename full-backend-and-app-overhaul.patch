+  int _demandFor(int weekday, int hour) {
+    int score = 1;
+    if (hour >= 12 && hour <= 14) score += 2;
+    if (hour >= 18 && hour <= 21) score += 3;
+    if (weekday == DateTime.friday || weekday == DateTime.saturday) score += 1;
+    return score.clamp(1, 5);
+  }
